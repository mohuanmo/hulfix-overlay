<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HULFix 主题色叠加层：经 Theme#applyStyle(res, true) 应用到活动主题之上。
         仅覆盖强调色相关角色（colorPrimary / container / secondary 系），
         中性色（背景/表面/文字）沿用基础主题，因此单一定义即可适配深浅色
         （颜色引用在视图读取属性时才解析，自动命中 values-night 变体）。 -->

    <style name="ThemeOverlay.HULFix.Seed1" parent="">
        <item name="colorPrimary">@color/hulfix_seed_1_primary</item>
        <item name="colorOnPrimary">@color/hulfix_seed_1_onPrimary</item>
        <item name="colorPrimaryContainer">@color/hulfix_seed_1_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/hulfix_seed_1_onPrimaryContainer</item>
        <item name="colorSecondary">@color/hulfix_seed_1_secondary</item>
        <item name="colorOnSecondary">@color/hulfix_seed_1_onSecondary</item>
        <item name="colorSecondaryContainer">@color/hulfix_seed_1_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/hulfix_seed_1_onSecondaryContainer</item>
    </style>

